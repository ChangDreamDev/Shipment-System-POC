# Copy to .env and adjust for your environment

# API base URL for fetch calls. Leave empty in dev to use Vite proxy (/api -> backend).
VITE_API_URL=

# Backend origin (Vite dev proxy target)
VITE_API_BASE_URL=http://localhost:8000

# Frontend dev server port
VITE_PORT=5173

# Google Maps JavaScript API key (enable "Maps JavaScript API")
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Also enable "Geolocation API" for "Use my location" network fallback

# Map ID for Advanced Markers (use DEMO_MAP_ID for dev, or create one in Google Cloud Console)
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
