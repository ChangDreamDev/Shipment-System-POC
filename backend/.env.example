# Copy to .env and fill in values
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=cinesis

# Same key as frontend; enable "Geocoding API" for city → lat/lon during profile extraction
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Comma-separated frontend URLs for production (e.g. https://your-app.vercel.app)
# Use * for local dev
CORS_ORIGINS=*
